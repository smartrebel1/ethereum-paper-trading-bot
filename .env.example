# ============================================================
# Trading bot - Phase 1 configuration
# LIVE TRADING IS NOT IMPLEMENTED. TRADING_MODE MUST BE "paper".
# Both of the two lines below are enforced by code AND by tests.
# ============================================================
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

# --- Instrument ---------------------------------------------
SYMBOL=ETHUSDT
TIMEFRAME=4h

# --- Frozen baseline strategy -------------------------------
STRATEGY_NAME=EMA200_ATR_BASELINE
STRATEGY_VERSION=1.0.0
EMA_PERIOD=200
ATR_PERIOD=14
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0
MAX_POSITION_PCT=0.10
MIN_CONFIDENCE=0.60
WARMUP_CANDLES=200
FEE_RATE=0.001
STARTING_BALANCE=200

# --- AI (disabled by default; baseline must run without it) --
ENABLE_AI_SHADOW=false
AI_PROVIDER=disabled
GEMINI_API_KEY=

# --- Storage ------------------------------------------------
DATABASE_URL=sqlite:///./data/trading.db

# --- API ----------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
